# Development only: never production values (RF-B18). `just dev` loads this file for the server
# process only. Copy it to apps/server/.env.

# The Postgres of `just db-up` (infra/compose.dev.yml). With DEV_PG_PORT, change the port here too.
DATABASE_URL=postgres://torneo:torneo_dev@127.0.0.1:5432/torneo
# Must match apps/web/.env: the WebSocket handshake compares Origin with it exactly.
PUBLIC_ORIGIN=http://localhost:5173
# Development echo of /ws; only works on a loopback http origin.
ENABLE_WS_ECHO=1
# Bind to loopback so `cargo run` does not publish 8080 on the local network. `server healthcheck`
# always calls 127.0.0.1, so it only works with 0.0.0.0 or 127.0.0.1.
BIND_ADDR=127.0.0.1
RUST_LOG=info
# Proxies whose X-Forwarded-For is read (exact /32 or /128 addresses). Empty in development: the
# Vite proxy of `just dev` adds no X-Forwarded-For and the peer is 127.0.0.1. In production the
# compose fixes it to 10.250.0.2/32 (ADR-0006 D2); it is never set in Coolify.
TRUSTED_PROXIES=
# Shared with apps/web/.env.example for internal requests (base64url, at least 32 bytes). These two
# are public development values: outside a loopback http origin the server refuses them (RF-B18).
INTERNAL_API_SECRET=Y3NJpi4_9UAo8Kx01a81pv33Dleek_Ax2e1xq4kLJpk
# Key of ip_hash = HMAC-SHA256(ip_key, IP_HASH_KEY) in auth_events and sessions (ADR-0008 D8).
IP_HASH_KEY=mtPdFLwnW5YGomZ3cu58sF-v6WhmO0aQRTksx_Ypr90
# Coins of the first-login grant (spec 008; provisional value, fixed by TA-27). 1 to 10 000.
DAILY_GRANT=100
# The fights (spec 010 RF11). Commented out: these are the defaults. The start checks that
# window + pre_live + 105 s fits in the cadence, and the cadence is 1 day at most.
# FIGHT_CADENCE_SECS=600
# FIGHT_BETTING_WINDOW_SECS=450
# FIGHT_PRE_LIVE_SECS=30
# Where the characters are; the default is relative to the root of the repo.
# CONTENT_DIR=content/characters
# OAuth apps of Google and Discord (spec 008 RF-C1). On loopback each provider needs both of its
# variables or neither (a half pair stops the start); outside loopback the four are required.
# How to register development apps: apps/server/README.md, "Login real en local". Real values go
# only in apps/server/.env (ignored by git): never commit them or paste them in an issue.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

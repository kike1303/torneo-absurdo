# Only for local development and e2e (RF-B18). Never copy these values to production.
# Copy to apps/web/.env for `just dev`.
PUBLIC_ORIGIN=http://localhost:5173
ENABLE_DEV_CATALOG=1
# The server of `just dev` (ADR-0008 D5): web calls it directly for /api/me and the form actions.
# It must differ from PUBLIC_ORIGIN. In production the compose fixes http://torneo-server:8080.
INTERNAL_API_URL=http://127.0.0.1:8080
# Development value shared with apps/server/.env.example (spec 008, RF-B18): web sends it in
# X-Internal-Secret. Outside a loopback http PUBLIC_ORIGIN both processes refuse it; production
# gets its own value from Coolify.
INTERNAL_API_SECRET=Y3NJpi4_9UAo8Kx01a81pv33Dleek_Ax2e1xq4kLJpk

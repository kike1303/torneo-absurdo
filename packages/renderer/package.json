{
  "name": "@torneo/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest/index.ts",
      "default": "./src/manifest/index.ts"
    },
    "./timeline": {
      "types": "./src/timeline/index.ts",
      "default": "./src/timeline/index.ts"
    },
    "./guide": {
      "types": "./src/guide/index.ts",
      "default": "./src/guide/index.ts"
    },
    "./scene": {
      "types": "./src/scene/index.ts",
      "default": "./src/scene/index.ts"
    },
    "./placeholders/*": "./placeholders/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:placeholders": "node --experimental-strip-types scripts/gen-placeholders.ts",
    "bench:prepare": "node --experimental-strip-types scripts/bench-prepare.ts"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}

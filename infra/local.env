# Values for `just prod-local` only (RF-C5), passed with `--env-file`. No secret: the database is
# the local Postgres of compose.local.yml, reachable only on the local `torneo-db` network.
# The production variables (IMAGE_TAG, PUBLIC_HOST, DATABASE_URL) live only in Coolify.
# Never create infra/.env with real values.
PUBLIC_HOST=localhost
DATABASE_URL=postgres://torneo:torneo_local@postgres:5432/torneo

# Values for `just prod-local` only (RF-C5), passed with `--env-file`. No secret: the database is
# the local Postgres of compose.local.yml, reachable only on the local `torneo-db` network, and
# INTERNAL_API_SECRET and IP_HASH_KEY are generated into infra/local.secrets.env (ignored by git)
# by scripts/local-secrets.sh. The production variables (IMAGE_TAG, PUBLIC_HOST, DATABASE_URL,
# INTERNAL_API_SECRET, IP_HASH_KEY) live only in Coolify.
# Never create infra/.env with real values.
PUBLIC_HOST=localhost
DATABASE_URL=postgres://torneo:torneo_local@postgres:5432/torneo
